@page "/turmas/nova"
@rendermode InteractiveServer
@page "/turmas/editar/{Id:int}"
@attribute [Authorize(Policy = Politicas.GerenciarTurmasAlunos)]
@using Microsoft.AspNetCore.Authorization
@using SistemaEscolarCompleto.Authorization
@using SistemaEscolarCompleto.Data
@using SistemaEscolarCompleto.Models
@using SistemaEscolarCompleto.Services
@inject ApplicationDbContext DbContext
@inject IAuditoriaService Auditoria
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>@(Id == 0 ? "Nova Turma" : "Editar Turma")</PageTitle>
<h3>@(Id == 0 ? "Nova Turma" : "Editar Turma")</h3>

<div class="row">
    <div class="col-md-5">
        <EditForm Model="modelo" OnValidSubmit="Salvar" FormName="formTurma">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" />

            @if (!string.IsNullOrEmpty(mensagemErro))
            {
                <div class="alert alert-danger">@mensagemErro</div>
            }

            <div class="mb-3">
                <label class="form-label">Nome da turma</label>
                <InputText class="form-control" @bind-Value="modelo.Nome" placeholder="Ex: 1º Ano A" />
                <ValidationMessage For="() => modelo.Nome" />
            </div>

            <div class="mb-3">
                <label class="form-label">Ano letivo</label>
                <InputText class="form-control" @bind-Value="modelo.AnoLetivo" placeholder="Ex: 2025" />
                <ValidationMessage For="() => modelo.AnoLetivo" />
            </div>

            <div class="mb-3">
                <label class="form-label">Turno</label>
                <InputSelect class="form-select" @bind-Value="modelo.Turno">
                    <option value="">Selecione...</option>
                    <option value="Manhã">Manhã</option>
                    <option value="Tarde">Tarde</option>
                    <option value="Noite">Noite</option>
                    <option value="Integral">Integral</option>
                </InputSelect>
                <ValidationMessage For="() => modelo.Turno" />
            </div>

            @if (Id != 0)
            {
                <div class="mb-3 form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="modelo.Ativa" id="chkAtiva" />
                    <label class="form-check-label" for="chkAtiva">Turma ativa</label>
                </div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a href="turmas" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private string usuarioId = string.Empty;
    private string usuarioNome = string.Empty;
    private string? mensagemErro;
    private Turma? turmaEditando;

    private FormModel modelo = new();

    public class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nome obrigatório")]
        public string Nome { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ano letivo obrigatório")]
        public string AnoLetivo { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Turno obrigatório")]
        public string Turno { get; set; } = string.Empty;

        public bool Ativa { get; set; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        usuarioNome = authState.User.FindFirst("NomeCompleto")?.Value ?? string.Empty;

        if (Id != 0)
        {
            turmaEditando = await DbContext.Turmas.FindAsync(Id);
            if (turmaEditando is not null)
            {
                modelo.Nome = turmaEditando.Nome;
                modelo.AnoLetivo = turmaEditando.AnoLetivo;
                modelo.Turno = turmaEditando.Turno;
                modelo.Ativa = turmaEditando.Ativa;
            }
        }
    }

    private async Task Salvar()
    {
        mensagemErro = null;

        if (Id == 0)
        {
            var turma = new Turma
            {
                Nome = modelo.Nome,
                AnoLetivo = modelo.AnoLetivo,
                Turno = modelo.Turno,
                Ativa = true
            };
            DbContext.Turmas.Add(turma);
            await DbContext.SaveChangesAsync();
            await Auditoria.RegistrarAsync(usuarioId, usuarioNome, "Criação", "Turma", turma.Id.ToString(),
                null, $"{turma.Nome} - {turma.AnoLetivo} - {turma.Turno}");
        }
        else
        {
            if (turmaEditando is null) return;
            string antes = $"{turmaEditando.Nome} | {turmaEditando.AnoLetivo} | {turmaEditando.Turno} | Ativa:{turmaEditando.Ativa}";
            turmaEditando.Nome = modelo.Nome;
            turmaEditando.AnoLetivo = modelo.AnoLetivo;
            turmaEditando.Turno = modelo.Turno;
            turmaEditando.Ativa = modelo.Ativa;
            await DbContext.SaveChangesAsync();
            await Auditoria.RegistrarAsync(usuarioId, usuarioNome, "Edição", "Turma", turmaEditando.Id.ToString(),
                antes, $"{turmaEditando.Nome} | {turmaEditando.AnoLetivo} | {turmaEditando.Turno} | Ativa:{turmaEditando.Ativa}");
        }

        Nav.NavigateTo("turmas");
    }
}