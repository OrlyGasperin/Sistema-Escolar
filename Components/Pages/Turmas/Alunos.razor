@page "/turmas/{TurmaId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.GerenciarTurmasAlunos)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SistemaEscolarCompleto.Authorization
@using SistemaEscolarCompleto.Data
@using SistemaEscolarCompleto.Models
@using SistemaEscolarCompleto.Services
@inject ApplicationDbContext DbContext
@inject IAuditoriaService Auditoria
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Alunos — @(turma?.Nome ?? "...")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a href="turmas" class="btn btn-sm btn-outline-secondary me-2">← Turmas</a>
        <h3 class="d-inline">Alunos — @turma?.Nome (@turma?.AnoLetivo)</h3>
    </div>
    <button class="btn btn-primary" @onclick="AbrirFormNovo">+ Novo Aluno</button>
</div>

@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="() => mensagemSucesso = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger alert-dismissible">
        @mensagemErro
        <button type="button" class="btn-close" @onclick="() => mensagemErro = null"></button>
    </div>
}

@if (alunos is null)
{
    <p><em>Carregando...</em></p>
}
else if (alunos.Count == 0)
{
    <p class="text-muted">Nenhum aluno cadastrado nesta turma.</p>
}
else
{
    <table class="table table-hover table-striped">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>Nascimento</th>
                <th>Responsável</th>
                <th>Telefone</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in alunos)
            {
                <tr>
                    <td>@a.NomeCompleto</td>
                    <td>@a.DataNascimento.ToString("dd/MM/yyyy")</td>
                    <td>@(a.NomeResponsavel ?? "—")</td>
                    <td>@(a.TelefoneResponsavel ?? "—")</td>
                    <td>
                        @if (a.Ativo)
                        {
                            <span class="badge bg-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inativo</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary me-1"
                                @onclick="() => AbrirFormEditar(a)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="() => ConfirmarExclusao(a)">Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* Modal: Cadastrar/Editar Aluno *@
@if (mostrarForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(alunoEditando is null ? "Novo Aluno" : "Editar Aluno")</h5>
                    <button type="button" class="btn-close" @onclick="FecharForm"></button>
                </div>
                <div class="modal-body">
                    @if (erros.Any())
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var erro in erros)
                                {
                                    <li>@erro</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Nome completo</label>
                        <input class="form-control" @bind="nomeCompleto" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Data de nascimento</label>
                        <input class="form-control" type="date"
                               value="@dataNascimento.ToString("yyyy-MM-dd")"
                               @onchange="e => dataNascimento = DateTime.SpecifyKind(
                                   DateTime.Parse(e.Value?.ToString() ?? DateTime.UtcNow.ToString()),
                                   DateTimeKind.Utc)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nome do responsável</label>
                        <input class="form-control" @bind="nomeResponsavel" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Telefone do responsável</label>
                        <input class="form-control" @bind="telefoneResponsavel" @bind:event="oninput" />
                    </div>
                    @if (alunoEditando is not null)
                    {
                        <div class="mb-3 form-check">
                            <input class="form-check-input" type="checkbox"
                                   @bind="ativo" id="chkAtivoAluno" />
                            <label class="form-check-label" for="chkAtivoAluno">Ativo</label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="FecharForm">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SalvarAluno">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

@* Modal: Confirmar exclusão *@
@if (alunoParaExcluir is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar exclusão</h5>
                </div>
                <div class="modal-body">
                    <p>Deseja excluir o aluno <strong>@alunoParaExcluir.NomeCompleto</strong>?</p>
                    @if (!string.IsNullOrEmpty(mensagemErroModal))
                    {
                        <div class="alert alert-danger">@mensagemErroModal</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary"
                            @onclick="() => alunoParaExcluir = null">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ExecutarExclusao">Excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int TurmaId { get; set; }

    private Turma? turma;
    private List<Aluno>? alunos;
    private Aluno? alunoEditando;
    private Aluno? alunoParaExcluir;
    private bool mostrarForm;

    // Campos do formulário
    private string nomeCompleto = string.Empty;
    private DateTime dataNascimento = DateTime.UtcNow.AddYears(-10);
    private string? nomeResponsavel;
    private string? telefoneResponsavel;
    private bool ativo = true;
    private List<string> erros = new();

    private string? mensagemSucesso;
    private string? mensagemErro;
    private string? mensagemErroModal;
    private string usuarioId = string.Empty;
    private string usuarioNome = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioId = authState.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        usuarioNome = authState.User.FindFirst("NomeCompleto")?.Value ?? string.Empty;
        await Carregar();
    }

    private async Task Carregar()
    {
        turma = await DbContext.Turmas.FindAsync(TurmaId);
        alunos = await DbContext.Alunos
            .Where(a => a.TurmaId == TurmaId)
            .OrderBy(a => a.NomeCompleto)
            .ToListAsync();
    }

    private void AbrirFormNovo()
    {
        alunoEditando = null;
        nomeCompleto = string.Empty;
        dataNascimento = DateTime.UtcNow.AddYears(-10);
        nomeResponsavel = null;
        telefoneResponsavel = null;
        ativo = true;
        erros = new();
        mostrarForm = true;
    }

    private void AbrirFormEditar(Aluno a)
    {
        alunoEditando = a;
        nomeCompleto = a.NomeCompleto;
        dataNascimento = DateTime.SpecifyKind(a.DataNascimento, DateTimeKind.Utc);
        nomeResponsavel = a.NomeResponsavel;
        telefoneResponsavel = a.TelefoneResponsavel;
        ativo = a.Ativo;
        erros = new();
        mostrarForm = true;
    }

    private void FecharForm()
    {
        mostrarForm = false;
        alunoEditando = null;
        erros = new();
    }

    private bool Validar()
    {
        erros = new();
        if (string.IsNullOrWhiteSpace(nomeCompleto))
            erros.Add("Nome completo obrigatório");
        return !erros.Any();
    }

    private async Task SalvarAluno()
    {
        if (!Validar()) return;

        mensagemSucesso = null;
        mensagemErro = null;

        if (alunoEditando is null)
        {
            var aluno = new Aluno
            {
                NomeCompleto = nomeCompleto,
                DataNascimento = DateTime.SpecifyKind(dataNascimento.Date, DateTimeKind.Utc),
                NomeResponsavel = nomeResponsavel,
                TelefoneResponsavel = telefoneResponsavel,
                TurmaId = TurmaId,
                Ativo = true,
                DataMatricula = DateTime.UtcNow
            };
            DbContext.Alunos.Add(aluno);
            await DbContext.SaveChangesAsync();
            await Auditoria.RegistrarAsync(usuarioId, usuarioNome, "Criação", "Aluno",
                aluno.Id.ToString(), null, $"{aluno.NomeCompleto} na turma {TurmaId}");
            mensagemSucesso = "Aluno cadastrado com sucesso!";
        }
        else
        {
            string antes = $"{alunoEditando.NomeCompleto} | Ativo:{alunoEditando.Ativo}";
            alunoEditando.NomeCompleto = nomeCompleto;
            alunoEditando.DataNascimento = DateTime.SpecifyKind(dataNascimento.Date, DateTimeKind.Utc);
            alunoEditando.NomeResponsavel = nomeResponsavel;
            alunoEditando.TelefoneResponsavel = telefoneResponsavel;
            alunoEditando.Ativo = ativo;
            await DbContext.SaveChangesAsync();
            await Auditoria.RegistrarAsync(usuarioId, usuarioNome, "Edição", "Aluno",
                alunoEditando.Id.ToString(), antes,
                $"{alunoEditando.NomeCompleto} | Ativo:{alunoEditando.Ativo}");
            mensagemSucesso = "Aluno atualizado com sucesso!";
        }

        FecharForm();
        await Carregar();
    }

    private void ConfirmarExclusao(Aluno a)
    {
        mensagemErroModal = null;
        alunoParaExcluir = a;
    }

    private async Task ExecutarExclusao()
    {
        if (alunoParaExcluir is null) return;

        bool temFaltas = await DbContext.Faltas.AnyAsync(f => f.AlunoId == alunoParaExcluir.Id);
        if (temFaltas)
        {
            mensagemErroModal = "Não é possível excluir: aluno possui faltas registradas. Desative-o em vez de excluir.";
            return;
        }

        DbContext.Alunos.Remove(alunoParaExcluir);
        await DbContext.SaveChangesAsync();
        await Auditoria.RegistrarAsync(usuarioId, usuarioNome, "Exclusão", "Aluno",
            alunoParaExcluir.Id.ToString(), alunoParaExcluir.NomeCompleto, null);
        alunoParaExcluir = null;
        await Carregar();
    }
}