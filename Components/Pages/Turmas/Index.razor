@page "/turmas"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.GerenciarTurmasAlunos)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SistemaEscolarCompleto.Authorization
@using SistemaEscolarCompleto.Data
@using SistemaEscolarCompleto.Models
@inject ApplicationDbContext DbContext
@inject NavigationManager Nav

<PageTitle>Turmas</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Turmas</h3>
    <a href="turmas/nova" class="btn btn-primary">+ Nova Turma</a>
</div>

@if (turmas is null)
{
    <p><em>Carregando...</em></p>
}
else if (turmas.Count == 0)
{
    <p class="text-muted">Nenhuma turma cadastrada.</p>
}
else
{
    <table class="table table-hover table-striped">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>Ano Letivo</th>
                <th>Turno</th>
                <th>Alunos</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in turmas)
            {
                <tr>
                    <td>@t.Nome</td>
                    <td>@t.AnoLetivo</td>
                    <td>@t.Turno</td>
                    <td>@t.Alunos.Count(a => a.Ativo)</td>
                    <td>
                        @if (t.Ativa)
                        {
                            <span class="badge bg-success">Ativa</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inativa</span>
                        }
                    </td>
                    <td>
                        <a href="turmas/@t.Id" class="btn btn-sm btn-outline-primary me-1">Alunos</a>
                        <a href="turmas/editar/@t.Id" class="btn btn-sm btn-outline-secondary me-1">Editar</a>
                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="() => ConfirmarExclusao(t)">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (turmaParaExcluir is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar exclusão</h5>
                </div>
                <div class="modal-body">
                    <p>Deseja excluir a turma <strong>@turmaParaExcluir.Nome</strong>?</p>
                    @if (!string.IsNullOrEmpty(mensagemErro))
                    {
                        <div class="alert alert-danger">@mensagemErro</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => turmaParaExcluir = null">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ExecutarExclusao">Excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Turma>? turmas;
    private Turma? turmaParaExcluir;
    private string? mensagemErro;

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        turmas = await DbContext.Turmas
            .Include(t => t.Alunos)
            .OrderByDescending(t => t.AnoLetivo)
            .ThenBy(t => t.Nome)
            .ToListAsync();
    }

    private void ConfirmarExclusao(Turma t) { mensagemErro = null; turmaParaExcluir = t; }

    private async Task ExecutarExclusao()
    {
        if (turmaParaExcluir is null) return;

        bool temAlunos = await DbContext.Alunos.AnyAsync(a => a.TurmaId == turmaParaExcluir.Id);
        if (temAlunos)
        {
            mensagemErro = "Não é possível excluir: a turma possui alunos vinculados. Desative-a em vez de excluir.";
            return;
        }

        DbContext.Turmas.Remove(turmaParaExcluir);
        await DbContext.SaveChangesAsync();
        turmaParaExcluir = null;
        await Carregar();
    }
}