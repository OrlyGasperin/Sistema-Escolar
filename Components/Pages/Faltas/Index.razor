@page "/faltas"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.LancarFalta)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SistemaEscolarCompleto.Authorization
@using SistemaEscolarCompleto.Data
@using SistemaEscolarCompleto.Models
@using SistemaEscolarCompleto.Services
@inject ApplicationDbContext DbContext
@inject IFaltaService FaltaService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Faltas</PageTitle>

<h3>Registro de Faltas</h3>

@* Abas *@
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <button class="nav-link @(abaAtiva == "lancar" ? "active" : "")"
                @onclick='() => abaAtiva = "lancar"'>
            📋 Lançar Faltas
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(abaAtiva == "historico" ? "active" : "")"
                @onclick='() => abaAtiva = "historico"'>
            🕓 Histórico de Faltas
        </button>
    </li>
</ul>

@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="() => mensagemSucesso = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger alert-dismissible">
        @mensagemErro
        <button type="button" class="btn-close" @onclick="() => mensagemErro = null"></button>
    </div>
}

@* ABA: LANÇAR FALTAS *@
@if (abaAtiva == "lancar")
{
    <div class="card">
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Turma</label>
                    <select class="form-select" @onchange="SelecionarTurma">
                        <option value="0">Selecione a turma...</option>
                        @foreach (var t in turmasDisponiveis)
                        {
                            <option value="@t.Id">@t.Nome (@t.AnoLetivo)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Matéria</label>
                    <select class="form-select" @onchange="SelecionarMateria" disabled="@(turmaSelecionadaId == 0)">
                        <option value="0">Selecione a matéria...</option>
                        @foreach (var m in materiasFiltradas)
                        {
                            <option value="@m.Id">@m.Nome</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Data da aula</label>
                    <InputDate class="form-control" @bind-Value="dataAula" disabled="@(turmaSelecionadaId == 0)" />
                </div>
            </div>

            @if (turmaSelecionadaId > 0 && materiaSelecionadaId > 0 && alunosDaTurma.Any())
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Alunos — marque os <strong>presentes</strong></h5>
                    <div>
                        <button class="btn btn-sm btn-outline-success me-2" @onclick="MarcarTodos">✓ Todos presentes</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="DesmarcarTodos">✗ Todos faltaram</button>
                    </div>
                </div>

                <p class="text-muted small mb-3">Alunos <strong>desmarcados</strong> receberão falta.</p>

                <div class="row g-2 mb-4">
                    @foreach (var aluno in alunosDaTurma)
                    {
                        <div class="col-md-4 col-lg-3">
                            <div class="form-check border rounded p-2 @(presencas.ContainsKey(aluno.Id) && presencas[aluno.Id] ? "border-success bg-light" : "border-danger")">
                                <input class="form-check-input" type="checkbox"
                                       id="aluno_@aluno.Id"
                                       checked="@(presencas.ContainsKey(aluno.Id) && presencas[aluno.Id])"
                                       @onchange="e => TogglePresenca(aluno.Id, e)" />
                                <label class="form-check-label" for="aluno_@aluno.Id">
                                    @aluno.NomeCompleto
                                </label>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="flex-grow-1">
                        <label class="form-label">Observação geral (opcional)</label>
                        <InputText class="form-control" @bind-Value="observacaoGeral"
                                   placeholder="Ex: Aula de reposição" />
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-primary px-4" @onclick="LancarFaltas">
                            💾 Salvar faltas
                        </button>
                    </div>
                </div>
            }
            else if (turmaSelecionadaId > 0 && materiaSelecionadaId > 0 && !alunosDaTurma.Any())
            {
                <div class="alert alert-warning">Nenhum aluno ativo nesta turma.</div>
            }
            else if (turmaSelecionadaId > 0 && materiaSelecionadaId == 0)
            {
                <p class="text-muted">Selecione a matéria para ver os alunos.</p>
            }
            else
            {
                <p class="text-muted">Selecione a turma e a matéria para lançar faltas.</p>
            }
        </div>
    </div>
}

@* ABA: HISTÓRICO *@
@if (abaAtiva == "historico")
{
    <div class="row mb-3 g-2">
        <div class="col-md-3">
            <label class="form-label">Turma</label>
            <select class="form-select" @onchange="FiltrarHistTurma">
                <option value="0">Todas</option>
                @foreach (var t in turmasDisponiveis)
                {
                    <option value="@t.Id">@t.Nome (@t.AnoLetivo)</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Matéria</label>
            <select class="form-select" @onchange="FiltrarHistMateria">
                <option value="0">Todas</option>
                @foreach (var m in todasMaterias)
                {
                    <option value="@m.Id">@m.Nome</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Data inicial</label>
            <InputDate class="form-control" @bind-Value="filtroDataInicio" @bind-Value:after="CarregarHistorico" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Data final</label>
            <InputDate class="form-control" @bind-Value="filtroDataFim" @bind-Value:after="CarregarHistorico" />
        </div>
    </div>

    @if (faltas is null)
    {
        <p><em>Carregando...</em></p>
    }
    else if (faltas.Count == 0)
    {
        <p class="text-muted">Nenhuma falta encontrada.</p>
    }
    else
    {
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Data</th>
                    <th>Aluno</th>
                    <th>Turma</th>
                    <th>Matéria</th>
                    <th>Professor</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in faltas)
                {
                    <tr>
                        <td>@f.Data.ToString("dd/MM/yyyy")</td>
                        <td>@f.Aluno?.NomeCompleto</td>
                        <td>@f.Turma?.Nome</td>
                        <td>@f.Materia?.Nome</td>
                        <td>@f.ProfessorLancou?.NomeCompleto</td>
                        <td>
                            @if (f.Status == StatusFalta.Ativa)
                            {
                                <span class="badge bg-danger">Ativa</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Cancelada</span>
                            }
                            @if (f.Solicitacoes.Any(s => s.Status == StatusSolicitacao.Pendente))
                            {
                                <span class="badge bg-warning text-dark ms-1">Solicitação pendente</span>
                            }
                        </td>
                        <td>
                            <AuthorizeView Policy="@Politicas.EditarFaltaDireto" Context="authEdit">
                                <Authorized>
                                    <button class="btn btn-sm btn-outline-secondary me-1"
                                            @onclick="() => AbrirFormEditar(f)">
                                        Editar
                                    </button>
                                </Authorized>
                            </AuthorizeView>

                            @if (f.ProfessorLancouId == usuarioId &&
                                 !f.Solicitacoes.Any(s => s.Status == StatusSolicitacao.Pendente))
                            {
                                <button class="btn btn-sm btn-outline-warning"
                                        @onclick="() => AbrirFormSolicitacao(f)">
                                    Solicitar alteração
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@* Modal editar falta *@
@if (mostrarFormEditar && faltaEditando is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Falta</h5>
                    <button type="button" class="btn-close" @onclick="() => mostrarFormEditar = false"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Aluno:</strong> @faltaEditando.Aluno?.NomeCompleto</p>
                    <p><strong>Data:</strong> @faltaEditando.Data.ToString("dd/MM/yyyy")</p>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" @bind="statusEditar">
                            <option value="@StatusFalta.Ativa">Ativa</option>
                            <option value="@StatusFalta.Cancelada">Cancelada</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Observação</label>
                        <textarea class="form-control" rows="2" @bind="observacaoEditar"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => mostrarFormEditar = false">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SalvarEdicaoDireta">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

@* Modal solicitar alteração *@
@if (mostrarFormSolicitacao && faltaSolicitacao is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Solicitar Alteração de Falta</h5>
                    <button type="button" class="btn-close" @onclick="() => mostrarFormSolicitacao = false"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Aluno:</strong> @faltaSolicitacao.Aluno?.NomeCompleto</p>
                    <p><strong>Data:</strong> @faltaSolicitacao.Data.ToString("dd/MM/yyyy")</p>
                    <div class="mb-3">
                        <label class="form-label">Alterar para</label>
                        <select class="form-select" @bind="statusSolicitacao">
                            <option value="@StatusFalta.Ativa">Ativa</option>
                            <option value="@StatusFalta.Cancelada">Cancelada</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Motivo</label>
                        <textarea class="form-control" rows="3" @bind="motivoSolicitacao"></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(mensagemErroModal))
                    {
                        <div class="alert alert-danger">@mensagemErroModal</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => mostrarFormSolicitacao = false">Cancelar</button>
                    <button class="btn btn-warning" @onclick="EnviarSolicitacao">Enviar solicitação</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string abaAtiva = "lancar";
    private string usuarioId = string.Empty;
    private string usuarioNome = string.Empty;
    private string tipoUsuario = string.Empty;

    // Lançar faltas
    private List<Turma> turmasDisponiveis = new();
    private List<Materia> todasMaterias = new();
    private List<Materia> materiasFiltradas = new();
    private List<Aluno> alunosDaTurma = new();
    private List<ProfessorMateriaTurma> vinculos = new();
    private Dictionary<int, bool> presencas = new();
    private int turmaSelecionadaId;
    private int materiaSelecionadaId;
    private DateTime dataAula = DateTime.UtcNow.Date;
    private string? observacaoGeral;

    // Histórico
    private List<Falta>? faltas;
    private int filtroHistTurmaId;
    private int filtroHistMateriaId;
    private DateTime filtroDataInicio = DateTime.SpecifyKind(DateTime.UtcNow.Date.AddDays(-30), DateTimeKind.Utc);
    private DateTime filtroDataFim = DateTime.SpecifyKind(DateTime.UtcNow.Date, DateTimeKind.Utc);

    // Editar
    private Falta? faltaEditando;
    private bool mostrarFormEditar;
    private StatusFalta statusEditar;
    private string? observacaoEditar;

    // Solicitação
    private Falta? faltaSolicitacao;
    private bool mostrarFormSolicitacao;
    private StatusFalta statusSolicitacao = StatusFalta.Cancelada;
    private string motivoSolicitacao = string.Empty;
    private string? mensagemErroModal;

    private string? mensagemSucesso;
    private string? mensagemErro;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        usuarioNome = authState.User.FindFirst("NomeCompleto")?.Value ?? string.Empty;
        tipoUsuario = authState.User.FindFirst(ClaimsTipoUsuario.ClaimType)?.Value ?? string.Empty;

        vinculos = await DbContext.ProfessorMateriaTurmas.Where(v => v.Ativo).ToListAsync();
        todasMaterias = await DbContext.Materias.Where(m => m.Ativa).OrderBy(m => m.Nome).ToListAsync();

        var turmas = await DbContext.Turmas.Where(t => t.Ativa).OrderBy(t => t.Nome).ToListAsync();

        if (tipoUsuario == TipoUsuario.Professor.ToString())
        {
            var turmaIds = vinculos.Where(v => v.ProfessorId == usuarioId)
                .Select(v => v.TurmaId).Distinct().ToHashSet();
            turmasDisponiveis = turmas.Where(t => turmaIds.Contains(t.Id)).ToList();
        }
        else
        {
            turmasDisponiveis = turmas;
        }

        await CarregarHistorico();
    }

    private async Task SelecionarTurma(ChangeEventArgs e)
    {
        turmaSelecionadaId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        materiaSelecionadaId = 0;
        alunosDaTurma = new();
        presencas = new();

        if (turmaSelecionadaId > 0)
        {
            IEnumerable<int> materiaIds;
            if (tipoUsuario == TipoUsuario.Professor.ToString())
                materiaIds = vinculos.Where(v => v.TurmaId == turmaSelecionadaId && v.ProfessorId == usuarioId)
                    .Select(v => v.MateriaId);
            else
                materiaIds = vinculos.Where(v => v.TurmaId == turmaSelecionadaId)
                    .Select(v => v.MateriaId).Distinct();

            materiasFiltradas = todasMaterias.Where(m => materiaIds.Contains(m.Id)).ToList();
        }
        else
        {
            materiasFiltradas = new();
        }
    }

    private async Task SelecionarMateria(ChangeEventArgs e)
    {
        materiaSelecionadaId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;

        if (materiaSelecionadaId > 0 && turmaSelecionadaId > 0)
        {
            alunosDaTurma = await DbContext.Alunos
                .Where(a => a.TurmaId == turmaSelecionadaId && a.Ativo)
                .OrderBy(a => a.NomeCompleto)
                .ToListAsync();

            // Verifica faltas já existentes nesta data/matéria/turma
            var faltasExistentes = await DbContext.Faltas
                .Where(f => f.TurmaId == turmaSelecionadaId &&
                            f.MateriaId == materiaSelecionadaId &&
                            f.Data.Date == dataAula.Date &&
                            f.Status == StatusFalta.Ativa)
                .Select(f => f.AlunoId)
                .ToListAsync();

            // Marca como presente quem NÃO tem falta
            presencas = alunosDaTurma.ToDictionary(
                a => a.Id,
                a => !faltasExistentes.Contains(a.Id));
        }
    }

    private void TogglePresenca(int alunoId, ChangeEventArgs e)
    {
        bool marcado = (bool)(e.Value ?? false);
        presencas[alunoId] = marcado;
    }

    private void MarcarTodos()
    {
        foreach (var key in presencas.Keys.ToList())
            presencas[key] = true;
    }

    private void DesmarcarTodos()
    {
        foreach (var key in presencas.Keys.ToList())
            presencas[key] = false;
    }

    private async Task LancarFaltas()
    {
        dataAula = DateTime.SpecifyKind(dataAula, DateTimeKind.Utc);
        mensagemErro = null;
        mensagemSucesso = null;

        var ausentes = presencas.Where(p => !p.Value).Select(p => p.Key).ToList();

        if (!ausentes.Any())
        {
            mensagemSucesso = "Nenhuma falta lançada — todos presentes!";
            return;
        }

        int lancadas = 0;
        int ignoradas = 0;

        foreach (var alunoId in ausentes)
        {
            var resultado = await FaltaService.LancarFaltaAsync(
                alunoId, materiaSelecionadaId, turmaSelecionadaId,
                dataAula, usuarioId, usuarioNome, observacaoGeral);

            if (resultado.Sucesso) lancadas++;
            else ignoradas++;
        }

        mensagemSucesso = $"{lancadas} falta(s) lançada(s) com sucesso.";
        if (ignoradas > 0)
            mensagemSucesso += $" {ignoradas} já existia(m) e foram ignorada(s).";

        // Recarrega para refletir estado atual
        await SelecionarMateria(new ChangeEventArgs { Value = materiaSelecionadaId.ToString() });
        await CarregarHistorico();
    }

    private async Task CarregarHistorico()
    {
        filtroDataInicio = DateTime.SpecifyKind(filtroDataInicio, DateTimeKind.Utc);
        filtroDataFim = DateTime.SpecifyKind(filtroDataFim, DateTimeKind.Utc);
        var query = DbContext.Faltas
            .Include(f => f.Aluno)
            .Include(f => f.Turma)
            .Include(f => f.Materia)
            .Include(f => f.ProfessorLancou)
            .Include(f => f.Solicitacoes)
            .Where(f => f.Data >= filtroDataInicio.ToUniversalTime()
         && f.Data <= filtroDataFim.ToUniversalTime());

        if (tipoUsuario == TipoUsuario.Professor.ToString())
            query = query.Where(f => f.ProfessorLancouId == usuarioId);

        if (filtroHistTurmaId > 0) query = query.Where(f => f.TurmaId == filtroHistTurmaId);
        if (filtroHistMateriaId > 0) query = query.Where(f => f.MateriaId == filtroHistMateriaId);

        faltas = await query.OrderByDescending(f => f.Data).ToListAsync();
    }

    private async Task FiltrarHistTurma(ChangeEventArgs e)
    {
        filtroHistTurmaId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        await CarregarHistorico();
    }

    private async Task FiltrarHistMateria(ChangeEventArgs e)
    {
        filtroHistMateriaId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        await CarregarHistorico();
    }

    private void AbrirFormEditar(Falta f)
    {
        faltaEditando = f;
        statusEditar = f.Status;
        observacaoEditar = f.Observacao;
        mostrarFormEditar = true;
    }

    private async Task SalvarEdicaoDireta()
    {
        if (faltaEditando is null) return;
        var resultado = await FaltaService.EditarFaltaDiretoAsync(
            faltaEditando.Id, statusEditar, usuarioId, usuarioNome, observacaoEditar);

        if (!resultado.Sucesso) { mensagemErro = resultado.MensagemErro; return; }

        mostrarFormEditar = false;
        mensagemSucesso = "Falta atualizada!";
        await CarregarHistorico();
    }

    private void AbrirFormSolicitacao(Falta f)
    {
        faltaSolicitacao = f;
        statusSolicitacao = StatusFalta.Cancelada;
        motivoSolicitacao = string.Empty;
        mensagemErroModal = null;
        mostrarFormSolicitacao = true;
    }

    private async Task EnviarSolicitacao()
    {
        if (faltaSolicitacao is null) return;
        if (string.IsNullOrWhiteSpace(motivoSolicitacao))
        {
            mensagemErroModal = "Informe o motivo da solicitação.";
            return;
        }

        var resultado = await FaltaService.SolicitarAlteracaoAsync(
            faltaSolicitacao.Id, usuarioId, usuarioNome,
            statusSolicitacao, motivoSolicitacao);

        if (!resultado.Sucesso) { mensagemErroModal = resultado.MensagemErro; return; }

        mostrarFormSolicitacao = false;
        mensagemSucesso = "Solicitação enviada!";
        await CarregarHistorico();
    }
}