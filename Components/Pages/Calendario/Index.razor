@page "/calendario"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.GerenciarCalendario)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SistemaEscolarCompleto.Authorization
@using SistemaEscolarCompleto.Data
@using SistemaEscolarCompleto.Models
@using SistemaEscolarCompleto.Services
@inject ApplicationDbContext DbContext
@inject IAuditoriaService Auditoria
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Horário de Aulas</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3>Horário de Aulas</h3>
    @if (turmaSelecionadaId > 0)
    {
        <button class="btn btn-outline-secondary" @onclick="Imprimir">🖨️ Imprimir</button>
    }
</div>

<div class="row mb-4 g-2 no-print">
    <div class="col-md-4">
        <label class="form-label fw-semibold">Turma</label>
        <select class="form-select" @onchange="SelecionarTurma">
            <option value="0">Selecione a turma...</option>
            @foreach (var t in turmas)
            {
                <option value="@t.Id">@t.Nome (@t.AnoLetivo)</option>
            }
        </select>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible no-print">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="() => mensagemSucesso = null"></button>
    </div>
}

@if (turmaSelecionadaId > 0)
{
    <div id="horario-impressao">
        <h5 class="mb-3 print-title">
            Horário de Aulas — @turmas.FirstOrDefault(t => t.Id == turmaSelecionadaId)?.Nome
            (@turmas.FirstOrDefault(t => t.Id == turmaSelecionadaId)?.AnoLetivo)
        </h5>

        <div class="table-responsive">
            <table class="horario-table">
                <thead>
                    <tr class="horario-header">
                        <th class="horario-th-label">Aula / Horário</th>
                        @foreach (var dia in diasSemana)
                        {
                            <th class="horario-th-dia">@dia.Value</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int aula = 1; aula <= 9; aula++)
                    {
                        var aulaNum = aula;
                        var zebraClass = aulaNum % 2 == 0 ? "horario-row-even" : "horario-row-odd";
                        <tr class="@zebraClass">
                            <td class="horario-label-cell">
                                <div class="fw-semibold">@aulaNum ª aula</div>
                                <div class="horario-time">@HorarioTexto(aulaNum)</div>
                            </td>
                            @foreach (var dia in diasSemana)
                            {
                                var diaN = dia.Key;
                                var horario = horarios.FirstOrDefault(h =>
                                    h.DiaSemana == diaN && h.NumeroAula == aulaNum);

                                <td class="horario-cell">
                                    @if (horario != null)
                                    {
                                        <div class="horario-materia-nome">@horario.Materia?.Nome</div>
                                        <div class="no-print mt-1">
                                            <select class="form-select form-select-sm horario-select"
                                                    @onchange="e => AlterarMateria(horario, e)">
                                                <option value="0">— remover —</option>
                                                @foreach (var m in materias)
                                                {
                                                    <option value="@m.Id"
                                                            selected="@(m.Id == horario.MateriaId)">
                                                        @m.Nome
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="no-print">
                                            <select class="form-select form-select-sm horario-select"
                                                    @onchange="e => AdicionarMateria(diaN, aulaNum, e)">
                                                <option value="0">▾ Selecionar matéria</option>
                                                @foreach (var m in materias)
                                                {
                                                    <option value="@m.Id">@m.Nome</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="print-only horario-vazio">—</div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Turma> turmas = new();
    private List<Materia> materias = new();
    private List<HorarioAula> horarios = new();

    private int turmaSelecionadaId;
    private string? mensagemSucesso;
    private string usuarioId = string.Empty;
    private string usuarioNome = string.Empty;

    private readonly Dictionary<int, string> diasSemana = new()
    {
        { 1, "Segunda-feira" },
        { 2, "Terça-feira" },
        { 3, "Quarta-feira" },
        { 4, "Quinta-feira" },
        { 5, "Sexta-feira" }
    };

    private static string HorarioTexto(int numero) => numero switch
    {
        1 => "07:30–08:20",
        2 => "08:20–09:10",
        3 => "09:25–10:15",
        4 => "10:15–11:05",
        5 => "11:05–11:55",
        6 => "12:55–13:45",
        7 => "13:45–14:35",
        8 => "14:50–15:40",
        9 => "15:40–16:30",
        _ => string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioId = authState.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        usuarioNome = authState.User.FindFirst("NomeCompleto")?.Value ?? string.Empty;

        turmas = await DbContext.Turmas.Where(t => t.Ativa).OrderBy(t => t.Nome).ToListAsync();
        materias = await DbContext.Materias.Where(m => m.Ativa).OrderBy(m => m.Nome).ToListAsync();
    }

    private async Task SelecionarTurma(ChangeEventArgs e)
    {
        turmaSelecionadaId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        if (turmaSelecionadaId > 0)
            await CarregarHorarios();
    }

    private async Task CarregarHorarios()
    {
        horarios = await DbContext.HorariosAula
            .Include(h => h.Materia)
            .Include(h => h.Professor)
            .Where(h => h.TurmaId == turmaSelecionadaId && h.Ativo)
            .ToListAsync();
    }

    private async Task AdicionarMateria(int dia, int aula, ChangeEventArgs e)
    {
        int materiaId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        if (materiaId == 0) return;

        var vinculo = await DbContext.ProfessorMateriaTurmas
            .FirstOrDefaultAsync(v => v.TurmaId == turmaSelecionadaId &&
                                      v.MateriaId == materiaId && v.Ativo);

        var novo = new HorarioAula
        {
            TurmaId = turmaSelecionadaId,
            DiaSemana = dia,
            NumeroAula = aula,
            MateriaId = materiaId,
            ProfessorId = vinculo?.ProfessorId ?? usuarioId,
            Ativo = true
        };

        DbContext.HorariosAula.Add(novo);
        await DbContext.SaveChangesAsync();
        await Auditoria.RegistrarAsync(usuarioId, usuarioNome, "Criação", "HorarioAula",
            novo.Id.ToString(), null,
            $"Turma:{turmaSelecionadaId} Dia:{dia} Aula:{aula} Materia:{materiaId}");

        mensagemSucesso = "Aula adicionada!";
        await CarregarHorarios();
    }

    private async Task AlterarMateria(HorarioAula horario, ChangeEventArgs e)
    {
        int materiaId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;

        if (materiaId == 0)
        {
            DbContext.HorariosAula.Remove(horario);
            await DbContext.SaveChangesAsync();
            await Auditoria.RegistrarAsync(usuarioId, usuarioNome, "Exclusão", "HorarioAula",
                horario.Id.ToString(),
                $"Dia:{horario.DiaSemana} Aula:{horario.NumeroAula}", null);
            mensagemSucesso = "Aula removida.";
        }
        else
        {
            string antes = $"Materia:{horario.MateriaId}";
            horario.MateriaId = materiaId;

            var vinculo = await DbContext.ProfessorMateriaTurmas
                .FirstOrDefaultAsync(v => v.TurmaId == turmaSelecionadaId &&
                                          v.MateriaId == materiaId && v.Ativo);
            if (vinculo != null)
                horario.ProfessorId = vinculo.ProfessorId;

            await DbContext.SaveChangesAsync();
            await Auditoria.RegistrarAsync(usuarioId, usuarioNome, "Edição", "HorarioAula",
                horario.Id.ToString(), antes, $"Materia:{materiaId}");
            mensagemSucesso = "Aula atualizada!";
        }

        await CarregarHorarios();
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("window.print");
    }
}